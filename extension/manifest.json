{
  "manifest_version": 3,
  "name": "Haven Agent Bridge",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "storage", "scripting", "alarms"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://haven.mindoodb.com/*",
    "https://mindoodb-haven-develop.pages.dev/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Haven Agent Bridge",
    "default_popup": "popup.html"
  }
}
